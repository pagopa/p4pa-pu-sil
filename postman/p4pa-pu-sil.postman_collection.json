  "item": [
    {
      "name": "00_login",
      "item": [
        {
          "name": "00_authtoken jwt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Fixed ReferenceError by removing the undefined function call\r",
                  "pm.test(\"MyPay - 01_authtoken - Responses with 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"MyPay - 01_authtoken jwt - Verify response body\", function () {\r",
                  "    let jsonResponse = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonResponse).to.have.property(\"access_token\");\r",
                  "    pm.expect(jsonResponse).to.have.property(\"token_type\");\r",
                  "    pm.expect(jsonResponse).to.have.property(\"expires_in\");\r",
                  "});\r",
                  "\r",
                  "let jsonResponse = pm.response.json();\r",
                  "pm.collectionVariables.set(\"accessToken\", jsonResponse.access_token);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{p4paAuthBaseUrl}}/oauth/token?client_id=piattaforma-unitaria&grant_type=urn:ietf:params:oauth:grant-type:token-exchange&subject_token={{tokenExchange_subjectToken}}&subject_issuer={{tokenExchange_issuer}}&scope=openid&subject_token_type=urn:ietf:params:oauth:token-type:jwt",
              "host": [
                "{{p4paAuthBaseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "piattaforma-unitaria"
                },
                {
                  "key": "grant_type",
                  "value": "urn:ietf:params:oauth:grant-type:token-exchange"
                },
                {
                  "key": "subject_token",
                  "value": "{{tokenExchange_subjectToken}}"
                },
                {
                  "key": "subject_issuer",
                  "value": "{{tokenExchange_issuer}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                },
                {
                  "key": "subject_token_type",
                  "value": "urn:ietf:params:oauth:token-type:jwt"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01_SEND_notification",
      "item": [
        {
          "name": "01_createSendNotification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"P4PA PU Sil create notification - Responses with 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"PU Sil - create send notification - Verify response body\", function () {\r",
                  "    let jsonResponse = pm.response.json();\r",
                  "    pm.expect(jsonResponse).have.property(\"sendNotificationId\");\r",
                  "    //pm.expect(jsonResponse).have.property(\"preloadRef\"); will be implemented with P4ADEV-2080\r",
                  "    pm.expect(jsonResponse).have.property(\"status\").to.eq(\"WAITING_FILE\");\r",
                  "\r",
                  "    pm.collectionVariables.set(\"sendNotificationId\", jsonResponse.sendNotificationId)\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const lodash = require('lodash');\r",
                  "const randomNumber = lodash.random(1000000000,9999999999)\r",
                  "const noticeCode = \"30000000\".concat(randomNumber)\r",
                  "pm.collectionVariables.set(\"noticeCode\", noticeCode)"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"paProtocolNumber\":\"Prot_001\",\r\n    \"recipient\": {\r\n        \"recipientType\": \"PF\", \r\n        \"taxId\": \"BNRMHL75C06G702B\",\r\n        \"denomination\": \"Michelangelo Buonarroti\",\r\n        \"physicalAddress\": { \r\n        \"address\": \"Via Larga 10\", \r\n        \"zip\": \"00186\", \r\n        \"municipality\": \"Roma\", \r\n        \"province\": \"RM\" \r\n        },\r\n        \"payments\": [ \r\n        {\r\n            \"pagoPa\": { \r\n                \"noticeCode\": {{noticeCode}}, \r\n                \"creditorTaxId\": \"77777777777\", \r\n                \"applyCost\": true, \r\n                \"attachment\": { \r\n                    \"fileName\":\"Pagamento.pdf\",\r\n                    \"contentType\": \"application/pdf\",\r\n                    \"digest\": \"45Iba3tn9Dfm7TX+AbtWDR1csMuHgEbrHi/zZr6DjHU=\"\r\n                }\r\n            }\r\n        }]\r\n    },\r\n    \"documents\":[{\r\n        \"fileName\":\"Notifica.pdf\",\r\n        \"contentType\": \"application/pdf\",\r\n        \"digest\": \"YSxsCpvZHvwL8IIosWJBUDjgUwa01sBHu6Cj4laQRLA=\"\r\n    }]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{puSilBaseUrl}}/organization/{{organizationId}}/send-notification",
              "host": [
                "{{puSilBaseUrl}}"
              ],
              "path": [
                "organization",
                "{{organizationId}}",
                "send-notification"
              ]
            }
          },
          "response": []
        },
