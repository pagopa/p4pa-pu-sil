                  "});\r",
                  "\r",
									"pm.test(\"P4PA PU Sil - get send legal fact list - Verify response body\", function () {\r",
                  "    let jsonResponse = pm.response.json();\r",
									"    pm.expect(jsonResponse).to.be.an(\"array\");\r",
									"    pm.expect(jsonResponse[0]).to.have.keys('iun','legalFactId').and.be.an(\"object\");\r",
									"    pm.expect(jsonResponse[0].legalFactId).to.have.keys('key','category').and.be.an(\"object\");\r",
                  "});"
